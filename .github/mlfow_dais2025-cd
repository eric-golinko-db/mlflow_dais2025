name: mlflow_dais2025 Bundle Deployment

on:
  push:
    branches:
      - 'dev'
      - 'qa'
      - 'main'
      - 'stage'
    paths:
      - 'MSL/**'
  workflow_dispatch:

jobs:
  deploy-bundle:
    runs-on: ubuntu-latest
    # Remove TARGET_ENV from here to avoid syntax issues
    # We'll set it in a separate step
    env:
      BRANCH_NAME: ${{ github.ref_name }}  # Capture the branch name

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Databricks CLI
        uses: databricks/setup-cli@v0.221.0

      - name: Determine TARGET_ENV
        id: set_target_env
        run: |
          echo "Branch name: $BRANCH_NAME"
          if [ "$BRANCH_NAME" = "main" ]; then
            echo "TARGET_ENV=prod" >> $GITHUB_ENV
          else
            echo "TARGET_ENV=$BRANCH_NAME" >> $GITHUB_ENV
          fi
        shell: bash

      - name: Set Environment Variables Conditionally
        run: |
          echo "Selected TARGET_ENV: $TARGET_ENV"

          if [ "$TARGET_ENV" = "dev" ]; then
            echo "DATABRICKS_CLIENT_ID=${{ secrets.SP_DEV_CLIENT_ID }}" >> $GITHUB_ENV
            echo "DATABRICKS_CLIENT_SECRET=${{ secrets.SP_DEV_CLIENT_SECRET }}" >> $GITHUB_ENV
          elif [ "$TARGET_ENV" = "qa" ]; then
            echo "DATABRICKS_CLIENT_ID=${{ secrets.SP_QA_CLIENT_ID }}" >> $GITHUB_ENV
            echo "DATABRICKS_CLIENT_SECRET=${{ secrets.SP_QA_CLIENT_SECRET }}" >> $GITHUB_ENV
          elif [ "$TARGET_ENV" = "stage" ]; then
            echo "DATABRICKS_CLIENT_ID=${{ secrets.SP_STAGE_CLIENT_ID }}" >> $GITHUB_ENV
            echo "DATABRICKS_CLIENT_SECRET=${{ secrets.SP_STAGE_CLIENT_SECRET }}" >> $GITHUB_ENV
          elif [ "$TARGET_ENV" = "prod" ]; then
            echo "DATABRICKS_CLIENT_ID=${{ secrets.SP_PRD_CLIENT_ID }}" >> $GITHUB_ENV
            echo "DATABRICKS_CLIENT_SECRET=${{ secrets.SP_PRD_CLIENT_SECRET }}" >> $GITHUB_ENV
          else
            echo "Error: Unknown TARGET_ENV value: $TARGET_ENV"
            exit 1
          fi
        shell: bash

      - name: Validate MSL Bundle
        run: |
          echo "Validating environment: $TARGET_ENV"
          databricks bundle validate -t "$TARGET_ENV"
        working-directory: ./MSL

      # - name: Deploy MSL Bundle
      #   run: |
      #     echo "Deploying to environment: $TARGET_ENV"
      #     databricks bundle deploy -t "$TARGET_ENV"
      #   working-directory: ./MSL

      ## Running on merge
      - name: Deploy MSL Bundle (or Run in QA/Prod)
        run: |
          echo "Processing environment: $TARGET_ENV"
          if [ "$TARGET_ENV" = "dev" ]; then
            echo "Deploying using databricks bundle deploy to environment: $TARGET_ENV"
            databricks bundle deploy -t "$TARGET_ENV"
          else
            echo "Deploying using databricks bundle deploy to environment: $TARGET_ENV"
            databricks bundle deploy -t "$TARGET_ENV"
            echo "Running using databricks bundle run to environment: $TARGET_ENV"
            databricks bundle run msl_ingest -t "$TARGET_ENV"
            echo "Running using databricks bundle run to environment: $TARGET_ENV"
            databricks bundle run msl_deploy -t "$TARGET_ENV"
          fi
        working-directory: ./MSL